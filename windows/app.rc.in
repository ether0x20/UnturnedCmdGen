#include <windows.h>

IDI_ICON1 ICON "@WIN_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @RC_VERSION@
 PRODUCTVERSION @RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ethan Zhou\0"
            VALUE "FileDescription", "Unturned server command generator\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "UnturnedCmdGen\0"
            VALUE "LegalCopyright", "Copyright (c) Ethan Zhou. MIT License.\0"
            VALUE "OriginalFilename", "UnturnedCmdGen.exe\0"
            VALUE "ProductName", "Unturned Command Generator\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
